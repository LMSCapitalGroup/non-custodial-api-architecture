{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LMSCapitalGroup Non-Custodial API Permission Policy",
  "entity": "LMSCapitalGroup",
  "architecture_model": "NON_CUSTODIAL_SAAS",
  "terminal_integrations": ["MetaTrader5", "WebTrader"],
  "payment_clearing_delegation": "EXTERNAL_REGULATED_PSP_EMI",
  "governance": {
    "execution_mode": "HUMAN_IN_THE_LOOP",
    "autonomous_blackbox_trading": false,
    "manual_operator_confirmation_required": true
  },
  "api_key_constraints": {
    "market_telemetry_read": true,
    "margin_exposure_sync": true,
    "staged_order_routing": "REQUIRES_HITL_SIGNATURE",
    "direct_debit_to_software_vendor": false,
    "custodial_fund_withdrawal_scope": false
  },
  "compliance_sla": {
    "engine": "Compliance Copilot",
    "verification_window_business_days": {
      "min": 1,
      "max": 3
    },
    "encryption_standards": ["AES-256-GCM", "TLS-1.3"]
  }
}
